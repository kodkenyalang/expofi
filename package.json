{
  "name": "expofi",
  "description": "ExpoFi — a seed library that expects offspring. Next.js, Tailwind, @solana/kit, Anchor.",
  "keywords": [
    "anchor",
    "kit",
    "nextjs",
    "react",
    "solana-kit",
    "tailwind",
    "typescript"
  ],
  "create-solana-dapp": {
    "rename": {
      "scaffold": {
        "to": "{{name}}",
        "paths": [
          "app"
        ]
      }
    }
  },
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "anchor-build": "npm run anchor-check && node scripts/anchor.mjs build --ignore-keys",
    "anchor-check": "node scripts/check-anchor-version.mjs && node scripts/program-keypair.mjs",
    "anchor-test": "npm run anchor-build && cd anchor && cargo test",
    "build": "next build",
    "ci": "npm run build && npm run lint && npm run format:check",
    "codama:js": "codama run js",
    "demo-seed": "jiti scripts/devnet/seed-demo.ts",
    "dev": "next dev",
    "devnet-smoke": "jiti scripts/devnet/smoke.ts",
    "e2e": "jiti e2e/browser-flow.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "program-deploy": "node scripts/program-keypair.mjs --strict --program=seed_library && cd anchor && solana program deploy target/deploy/seed_library.so --program-id target/deploy/seed_library-keypair.json --url devnet",
    "program-mutants": "python3 -I scripts/mutation-check.py anchor",
    "program-test": "node scripts/program-keypair.mjs && cd anchor && cargo build-sbf && cargo test",
    "setup": "npm run anchor-build && npm run codama:js",
    "start": "next start"
  },
  "dependencies": {
    "@solana/kit": "^6.3.0",
    "@solana/kit-client-rpc": "^0.7.0",
    "@solana/kit-plugin-rpc": "^0.7.0",
    "@solana/wallet-standard-features": "^1.3.0",
    "@wallet-standard/app": "^1.1.0",
    "@wallet-standard/base": "^1.1.0",
    "@wallet-standard/features": "^1.1.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "swr": "^2.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.3",
    "@codama/renderers-js": "1.7.1",
    "@solana-program/system": "^0.12.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "codama": "1.10.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "jiti": "^2.7.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
